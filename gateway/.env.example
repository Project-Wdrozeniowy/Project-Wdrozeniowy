PORT=3000
BACKEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
CSRF_RATE_LIMIT_MAX=30
API_MAX_BODY_BYTES=1048576
UPSTREAM_TIMEOUT_MS=25000
BODY_TIMEOUT_MS=10000
# Empty for direct access. Only explicit trusted proxy IPs/CIDRs may be listed.
TRUSTED_PROXY_CIDRS=
# NODE_ENV=production for HTTPS deployments (enables production Helmet policy).

# Optional absolute path to built frontend (default: sibling frontend/dist).
# SPA_DIST_DIR=
# npm start enables SPA hosting; npm run dev stays API-only.
