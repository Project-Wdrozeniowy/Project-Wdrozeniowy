{
  "name": "orbita-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/run.mjs",
    "test:probe": "node scripts/run.mjs --probe-failure",
    "test:infra": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
