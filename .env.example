# Copy this file to .env and fill in the values
# .env is listed in .gitignore and must NOT be committed

# PostgreSQL
POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=change_me_in_production

# JWT
# Generate a 64-byte base64 secret, e.g.:
#   openssl rand -base64 64 | tr -d '\n'
# CRITICAL: must be identical in this file and in gateway/.env
JWT_SECRET=change_me_must_be_at_least_32_bytes_base64_encoded_string_here
JWT_ACCESS_EXPIRY=900   # 15 minutes in seconds
JWT_REFRESH_EXPIRY=604800   # 7 days in seconds

# Refresh-token cookie: Secure flag. Keep true in production (HTTPS).
# Set to false for local development over plain HTTP (Safari ignores Secure cookies on http://localhost).
COOKIE_SECURE=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Gateway
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Gateway internal secret (for backend-to-gateway event dispatch — not yet implemented)
INTERNAL_SECRET=change_me_internal_secret

# Swagger UI — set to true in local development only; must be false in production
SWAGGER_ENABLED=false

# AI tag suggestions (POST /api/ai/suggest-tags): any OpenAI-compatible chat completions API,
# for example Groq (https://api.groq.com/openai/v1), OpenRouter or a local Ollama (http://localhost:11434/v1).
# When set, the post title and the first 4000 characters of its content are sent to that provider.
# Leave AI_API_KEY empty to suggest tags by keyword extraction only. Never commit a real key.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=10s   # connect and read timeout of one call
