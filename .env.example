# Copy this file to .env and fill in the values
# .env is listed in .gitignore and must NOT be committed

# PostgreSQL
POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=change_me_in_production

# JWT
# Generate a 64-byte base64 secret, e.g.:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change_me_must_be_at_least_32_bytes_base64_encoded_string_here
JWT_ACCESS_EXPIRY=900   # 15 minutes in seconds
JWT_REFRESH_EXPIRY=604800   # 7 days in seconds

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Gateway internal secret (for backend-to-gateway event dispatch)
INTERNAL_SECRET=change_me_internal_secret
